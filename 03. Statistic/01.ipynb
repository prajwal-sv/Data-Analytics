   "source": [
    "import numpy as np\n",
    "\n",
    "x = np.array([2, 4, 6, 8])\n",
    "\n",
    "mean = np.mean(x)\n",
    "variance = np.var(x)\n",
    "std = np.std(x)\n",
    "\n",
    "print(mean)\n",
    "print(variance)\n",
    "print(std)"
   ]
  },
